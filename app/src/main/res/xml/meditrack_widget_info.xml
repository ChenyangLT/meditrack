<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget metadata: one entry, resizable.

  ## Sizing

  `minWidth` / `minHeight` use the platform's `70n - 30` formula and describe the SMALLEST size the
  tile may take, not its default: 4 columns = 250dp, 1 row = 40dp. `targetCellWidth` /
  `targetCellHeight` give the size the launcher places it at.

  Four columns by one row is the declared floor because that is the smallest shape this list can draw
  without cutting a medication name or its status off - which is exactly what the old fixed 2x2
  default did. The user drags the tile from there to whatever they want, and because the layout is
  derived from the real size (see `WidgetSizing`) every shape in between looks deliberate.

  `resizeMode="horizontal|vertical"` keeps both handles available: wider simply gives long medication
  names more room.

  ## Refresh

  `updatePeriodMillis` is 30 minutes - the fastest the platform allows - and is only a floor. The real
  cadence is the user's choice (10 seconds to 10 minutes), driven by the background guard service,
  with a 15-minute WorkManager job as the fallback when that service is switched off.

  `reconfigurable` is deliberately NOT declared: it advertises a configuration screen in the
  launcher, and this widget has none. `configuration_optional` is what lets it be placed without one.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minHeight="40dp"
    android:minWidth="250dp"
    android:minResizeHeight="40dp"
    android:minResizeWidth="250dp"
    android:previewImage="@drawable/ic_widget_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="4"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="configuration_optional" />
