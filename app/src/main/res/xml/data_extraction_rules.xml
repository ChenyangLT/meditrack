<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup / device-transfer rules for Android 12+.

  Only <include> is used: naming a domain that is not included would make the rule a no-op, and
  lint flags such an exclude as an error. Export files under `files/exports` are therefore simply
  never included, which keeps user-generated backups out of the cloud copy.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="meditrack.db" />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="meditrack.db" />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
