<?xml version="1.0" encoding="utf-8"?>
<!--
  Files the app may hand to another app through FileProvider.

  Exports live in `files/exports/` so the user can find them with a file manager and so the
  auto-backup rules can exclude them (a backup file inside a backup is noise).

  `cache/updates/` holds a downloaded update package, and is the one entry here that exists so the app
  can hand a file to the *system installer*. It lives in the cache rather than in `files/` on purpose:
  Android's package installer rejects a file it cannot read, and a cache file this app owns with an
  explicit read grant is the combination every updater needs - see ApkInstaller.
-->
<paths>
    <files-path
        name="exports"
        path="exports/" />
    <cache-path
        name="shared_cache"
        path="shared/" />
    <cache-path
        name="updates"
        path="updates/" />
</paths>
