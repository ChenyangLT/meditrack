    <!-- Humanised timing options -->
    <string name="settings_pre_reminder">提前预告</string>
    <string name="settings_pre_reminder_desc">在服药时间之前先提醒一次，让你有时间准备。它同时也是一次独立的提醒机会。</string>
    <string name="settings_pre_reminder_lead">提前多久</string>
    <string name="settings_digest">合并同一时段的提醒</string>
    <string name="settings_digest_desc">把几分钟内到期的多种药合并成一条通知，避免连续多次弹窗。</string>
    <string name="settings_cluster_window">合并的时间范围</string>
    <string name="settings_snooze_state">「稍后提醒」后保留状态</string>
    <string name="settings_snooze_state_desc">推迟后在通知栏保留一条「已推迟到几点」，不会像以前那样直接消失。</string>
    <string name="settings_catch_up">错过时间后提示补记</string>
    <string name="settings_catch_up_desc">提醒迟到太久时不再响铃，而是安静地提示「如果已经吃过，点一下补记」。</string>
    <string name="settings_stale_reminder">多久之后算「太晚了」</string>
    <string name="settings_quiet_defer">免打扰时段内顺延提醒</string>
    <string name="settings_quiet_defer_desc">免打扰时段内到点的提醒，会等到时段结束再发，而不是静默地发一条没人看得到的通知。</string>
    <string name="settings_heartbeat">自检频率</string>
    <string name="settings_heartbeat_desc">每隔这么久重新核对全部提醒并补齐丢失的闹钟。数值越小越不容易漏，但耗电略高。</string>
