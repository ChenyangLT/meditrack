# ------------------------------------------------------------------ Android / Gradle
*.iml
.gradle
/.idea
/build
/app/build
/captures
.externalNativeBuild
.cxx
local.properties

# Signing material must never be published. The debug keystore lives in ~/.android, outside the
# repository, so this is belt-and-braces for anyone who adds a release keystore later.
*.keystore
*.jks
!debug.keystore

# ------------------------------------------------------------------ build output
*.apk
*.aab
*.ap_
*.dex
*.class

# ------------------------------------------------------------------ local / editor
.DS_Store
Thumbs.db
*.log
*.hprof

# ------------------------------------------------------------------ tooling artifacts
# Scratch rendered by the verification and preview tooling, never part of the source.
.dsh-vision-router/
/artifacts/

# ------------------------------------------------------------------ delivery folder
# Where local hand-offs land: built installers, write-ups and preview images.
# Deliberately not published - these are multi-megabyte binaries and personal build notes, and the
# public repository distributes the same installers through GitHub Releases instead. Publishing them
# here as well would put every historical APK into git history forever.
/releases/
